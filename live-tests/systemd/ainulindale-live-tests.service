[Unit]
Description=Ainulindale Live Production Tests Runner
After=network.target

[Service]
Type=oneshot
User=dana
Group=dana
SupplementaryGroups=docker
WorkingDirectory=/home/dana/ainulindale-infra/live-tests
ExecStart=/home/dana/ainulindale-infra/live-tests/scripts/run-ainulindale-live-tests-cron.sh
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
